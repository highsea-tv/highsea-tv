#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-only
# highsea's config folder, kept across upgrades and uninstalls, and the shared folder chosen: the
# next upgrade's wizard shows it, and its preinst keeps it when no wizard ran.
. "$(dirname "$0")/common"
mkdir -p "$SYNOPKG_PKGVAR/config"
share=$(sed -n "s|^HIGHSEA_DATA='/var/packages/highsea/shares/\(.*\)'$|\1|p" "$SYNOPKG_PKGDEST/compose/.env")
printf 'share=%s\n' "$share" > "$SETTINGS"
exit 0
