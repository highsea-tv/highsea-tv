#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-only
# highsea's config folder, kept across upgrades and uninstalls, and the shared folder chosen at
# install, for the next upgrade's preinst.
. "$(dirname "$0")/common"
mkdir -p "$SYNOPKG_PKGVAR/config"
share=$(sed -n "s|^HIGHSEA_DATA='/var/packages/highsea/shares/\(.*\)'$|\1|p" "$SYNOPKG_PKGDEST/compose/.env")
echo "share=$share" > "$SETTINGS"
exit 0
