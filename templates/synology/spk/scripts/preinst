#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-only
# Writes the compose project's .env into the unpacked package, before Container Manager creates the
# project from it. An upgrade keeps the shared folder chosen at install, which postinst saved in
# the package's var folder (@appdata, kept across upgrades); /var/packages/highsea/var isn't linked
# while the new version's preinst runs, so it's read from the volume.
. "$(dirname "$0")/common"

saved="${SYNOPKG_PKGDEST_VOL:-/volume1}/@appdata/highsea/package.conf"
share=""
library=""
if [ "$SYNOPKG_PKG_STATUS" = UPGRADE ] && [ -r "$saved" ]; then
  share=$(sed -n 's/^share=//p' "$saved")
  library=$(sed -n 's/^library=//p' "$saved")
fi
[ -n "$share" ] || share="${wizard_data_share:-}"
# the wizard's choice (Phase 5 A1, ADR 0063): a singleselect's options reach the script as their
# keys, true or false (DSM 7.0 Developer Guide, WIZARD_UIFILES)
if [ -z "$library" ]; then
  library=managed
  [ "${wizard_library_read_only:-false}" = true ] && library=read-only
fi
if [ -z "$share" ]; then
  say "Choose a shared folder for highsea's films."
  exit 1
fi

if [ "$SYNOPKG_PKG_STATUS" = INSTALL ] && listening 3000; then
  say "Something on this NAS already uses port 3000. If it's highsea in Container Manager, stop and delete that project first, then install the package again."
  exit 1
fi

dri="/var/packages/highsea/target/compose/no-graphics"
gid=$(id -g)
for node in /dev/dri/renderD*; do
  [ -e "$node" ] || continue
  dri=/dev/dri
  gid=$(stat -c %g "$node")
  break
done

# read-only: the shared folder's media folder is mounted again over /data/media, read-only, so the
# kernel refuses every write there (EROFS) and highsea only reads it; downloads stay writable.
# Managed: Compose can't leave a mount out by a variable, so the empty folder is mounted read-only
# somewhere highsea never looks.
# The shared folder then belongs to that app's stack too, so what highsea makes (its downloads,
# previews and transcodes) goes in one folder of its own, `highsea`, which highsea creates: DSM
# grants the shared folder's permission only after postinst (the data-share worker's timing is
# FROM_ENABLE_TO_POSTUNINST, https://help.synology.com/developer-guide/resource_acquisition/data_share.html).
if [ "$library" = read-only ]; then
  media="/var/packages/highsea/shares/$share/media"
  media_at=/data/media
  work=/data/highsea
else
  media=/var/packages/highsea/target/compose/no-graphics
  media_at=/run/highsea-unused
  work=
fi

cat > "$SYNOPKG_PKGINST_TEMP_DIR/compose/.env" <<ENV
HIGHSEA_DATA='/var/packages/highsea/shares/$share'
HIGHSEA_LIBRARY=$library
HIGHSEA_MEDIA='$media'
HIGHSEA_MEDIA_AT=$media_at
HIGHSEA_WORK=$work
HIGHSEA_DRI=$dri
HIGHSEA_RENDER_GID=$gid
HIGHSEA_HOSTNAME=$(hostname -s 2>/dev/null || hostname)
ENV
exit 0
