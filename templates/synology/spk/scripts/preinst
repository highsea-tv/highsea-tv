#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-only
# Writes the compose project's .env into the unpacked package, before Container Manager creates the
# project from it, from the shared folder common's choose() reads and checks.
. "$(dirname "$0")/common"

choose || exit 1

if [ "$SYNOPKG_PKG_STATUS" = INSTALL ] && listening 3000; then
  say "Something on this NAS already uses port 3000. If it's highsea in Container Manager, stop and delete that project first, then install the package again."
  exit 1
fi

dri="/var/packages/highsea/target/compose/no-graphics"
gid=$(id -g)
for node in /dev/dri/renderD*; do
  [ -e "$node" ] || continue
  dri=/dev/dri
  gid=$(stat -c %g "$node")
  break
done

# The TUN device, for the built-in VPN's wireguard-go (DSM's kernel has no WireGuard): the host's
# /dev/net, which DSM makes once the tun module is loaded, or an empty folder, since Container
# Manager won't start a project whose bind source is missing. The package's scripts don't run as
# root, so they can't load the module themselves (DSM 7 Developer Guide, Privilege: a package that
# runs as root must be signed by Synology); Settings › VPN says what to do when it's missing.
tun="/var/packages/highsea/target/compose/no-tun"
[ -d /dev/net ] && tun=/dev/net

cat > "$SYNOPKG_PKGINST_TEMP_DIR/compose/.env" <<ENV
HIGHSEA_DATA='/var/packages/highsea/shares/$share'
HIGHSEA_DRI=$dri
HIGHSEA_TUN=$tun
HIGHSEA_RENDER_GID=$gid
HIGHSEA_HOSTNAME=$(hostname -s 2>/dev/null || hostname)
ENV
exit 0
