{
  "name": "highsea",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "design/*"
  ],
  "scripts": {
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "bun run --filter '*' typecheck && tsc -p scripts/tsconfig.json",
    "test": "bun test --isolate && bun run --filter @highsea-tv/mobile test && bun run --filter @highsea-tv/app test",
    "smoke": "node scripts/check-node.ts && node apps/server/scripts/smoke.ts",
    "check:node": "node scripts/check-node.ts",
    "explorations": "bunx serve design/explorations -l 4400",
    "prototypes": "bun run --filter @highsea-tv/prototypes dev",
    "docs": "bun run --filter @highsea-tv/docs dev",
    "web": "bun run --filter @highsea-tv/web dev",
    "licenses": "bun scripts/license-audit.ts",
    "audit": "bun scripts/audit.ts",
    "server": "bun run --filter @highsea-tv/server dev",
    "pin": "bun scripts/pin.ts",
    "one-place": "bun scripts/one-place.ts",
    "catalog:build": "bun scripts/catalog.ts build"
  },
  "engines": {
    "bun": ">=1.4",
    "node": "26.11.1"
  },
  "devDependencies": {
    "@babel/parser": "7.29.9",
    "@biomejs/biome": "2.5.15",
    "@highsea-tv/catalog": "workspace:*",
    "@highsea-tv/importers": "workspace:*",
    "@highsea-tv/indexers": "workspace:*",
    "@highsea-tv/media": "workspace:*",
    "@highsea-tv/metadata": "workspace:*",
    "@highsea-tv/stream": "workspace:*",
    "@highsea-tv/subtitles": "workspace:*",
    "@highsea-tv/torrent": "workspace:*",
    "@types/bun": "^1.4.3",
    "axe-core": "4.14.0",
    "playwright-core": "1.63.0",
    "typescript": "7.0.2"
  },
  "overrides": {
    "@dnd-kit/abstract": "0.5.0",
    "@dnd-kit/collision": "0.5.0",
    "@dnd-kit/geometry": "0.5.0",
    "@dnd-kit/state": "0.5.0",
    "expo-modules-core": "58.0.19",
    "expo-modules-jsi": "58.0.14",
    "react-native": "npm:react-native-tvos@0.88.0-0"
  },
  "patchedDependencies": {
    "react-native-screens@4.30.0": "patches/react-native-screens@4.30.0.patch"
  }
}
