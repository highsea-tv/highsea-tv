{
  "name": "highsea",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "design/*"
  ],
  "scripts": {
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "bun run --filter '*' typecheck && tsc -p scripts/tsconfig.json",
    "test": "bun test",
    "explorations": "bunx serve design/explorations -l 4400",
    "storybook": "bun run --filter @highsea/storybook storybook",
    "prototypes": "bun run --filter @highsea/prototypes dev",
    "licenses": "bun scripts/license-audit.ts",
    "server": "bun run --filter @highsea/server dev",
    "pin": "bun scripts/pin.ts"
  },
  "engines": {
    "bun": ">=1.4",
    "node": ">=24"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "^1.4.3",
    "typescript": "^7.0.2",
    "playwright-core": "1.63.0",
    "axe-core": "4.14.0"
  },
  "overrides": {
    "@dnd-kit/abstract": "0.5.0",
    "@dnd-kit/collision": "0.5.0",
    "@dnd-kit/geometry": "0.5.0",
    "@dnd-kit/state": "0.5.0"
  }
}
