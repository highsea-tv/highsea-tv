{
  "name": "@highsea-tv/app",
  "version": "0.4.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "web": "expo start --web",
    "web:server": "HIGHSEA_WEB_PROXY=${HIGHSEA_WEB_PROXY:-http://localhost:3000} EXPO_NO_TELEMETRY=1 expo start --web --port 3200",
    "prebuild": "expo prebuild --platform ios --clean",
    "prebuild:tv": "EXPO_TV=1 expo prebuild --platform ios --clean",
    "ios": "expo run:ios",
    "tv": "EXPO_TV=1 expo run:ios",
    "export:web": "EXPO_UNSTABLE_METRO_OPTIMIZE_GRAPH=1 EXPO_UNSTABLE_TREE_SHAKING=1 expo export --platform web --output-dir dist",
    "export:web:mock": "bun scripts/export-mock.ts",
    "export:desktop": "EXPO_PUBLIC_HIGHSEA_APP=desktop EXPO_UNSTABLE_METRO_OPTIMIZE_GRAPH=1 EXPO_UNSTABLE_TREE_SHAKING=1 expo export --platform web --output-dir dist-desktop",
    "web:desktop": "EXPO_PUBLIC_HIGHSEA_APP=desktop EXPO_NO_TELEMETRY=1 expo start --web --port 3201",
    "serve": "bun scripts/serve.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p test/tsconfig.json && tsc -p scripts/tsconfig.json",
    "test": "NODE_PATH=$PWD/node_modules jest"
  },
  "dependencies": {
    "@expo/metro-runtime": "58.0.14",
    "@formatjs/intl-locale": "5.3.12",
    "@formatjs/intl-numberformat": "9.4.3",
    "@formatjs/intl-pluralrules": "6.3.15",
    "@highsea-tv/api-contract": "workspace:*",
    "@highsea-tv/brand": "workspace:*",
    "@highsea-tv/client": "workspace:*",
    "@highsea-tv/core": "workspace:*",
    "@highsea-tv/fixtures": "workspace:*",
    "@highsea-tv/i18n": "workspace:*",
    "@highsea-tv/mock": "workspace:*",
    "@highsea-tv/native": "workspace:*",
    "@highsea-tv/sdk": "workspace:*",
    "@highsea-tv/tokens": "workspace:*",
    "@highsea-tv/ui": "workspace:*",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-opener": "2.7.2",
    "@tauri-apps/plugin-process": "2.4.0",
    "@tauri-apps/plugin-updater": "2.14.0",
    "expo": "58.0.11",
    "expo-audio": "58.0.9",
    "expo-camera": "58.0.10",
    "expo-constants": "58.0.12",
    "expo-crypto": "58.0.6",
    "expo-device": "58.0.5",
    "expo-file-system": "58.0.9",
    "expo-font": "58.0.8",
    "expo-haptics": "58.0.6",
    "expo-image": "58.0.15",
    "expo-linking": "58.0.13",
    "expo-modules-core": "58.0.19",
    "expo-router": "58.0.20",
    "expo-secure-store": "58.0.2",
    "expo-splash-screen": "58.0.9",
    "expo-status-bar": "58.0.3",
    "expo-system-ui": "58.0.6",
    "expo-video": "58.0.11",
    "expo-web-browser": "58.0.6",
    "lucide-react-native": "1.57.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "npm:react-native-tvos@0.88.0-0",
    "react-native-gesture-handler": "3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "0.21.4",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@babel/runtime": "7.29.10",
    "@highsea-tv/config": "workspace:*",
    "@react-native-tvos/config-tv": "0.1.7",
    "@react-native/jest-preset": "0.88.0",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "19.3.0",
    "jest": "30.5.2",
    "jest-expo": "58.0.11",
    "test-renderer": "1.3.0"
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native"
      ]
    }
  }
}
