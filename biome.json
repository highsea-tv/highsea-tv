{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!**/graft",
      "!**/LICENSE",
      "!.claude",
      "!packages/tokens/generated",
      "!packages/brand/assets",
      "!packages/brand/fonts",
      "!packages/brand/src/wordmark-data.ts",
      "!packages/ui/src/web/icons/glyphs.ts",
      "!packages/db/src/migrations.ts",
      "!packages/db/drizzle",
      "!apps/server/public",
      "!apps/docs/public",
      "!apps/server/openapi.json",
      "!packages/catalog/seed",
      "!apps/desktop/src-tauri/gen"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "css": { "parser": { "tailwindDirectives": true } },
  "javascript": {
    "formatter": { "quoteStyle": "single", "semicolons": "asNeeded", "trailingCommas": "all" }
  },
  "linter": {
    "enabled": true,
    "rules": { "preset": "recommended" }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "overrides": [
    {
      "includes": ["packages/ui/src/native/**", "apps/client/src/**", "packages/admin/src/**"],
      "linter": {
        "rules": {
          "correctness": {
            "useExhaustiveDependencies": {
              "level": "error",
              "options": {
                "reportMissingDependenciesArray": true,
                "hooks": [
                  { "name": "useAnimatedStyle", "closureIndex": 0, "dependenciesIndex": 1 },
                  { "name": "useDerivedValue", "closureIndex": 0, "dependenciesIndex": 1 },
                  { "name": "useAnimatedProps", "closureIndex": 0, "dependenciesIndex": 1 },
                  { "name": "useAnimatedReaction", "closureIndex": 0, "dependenciesIndex": 2 }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["design/assets/icons/**"],
      "linter": { "rules": { "a11y": { "noSvgWithoutTitle": "off" } } }
    },
    {
      "includes": ["design/explorations/**"],
      "linter": {
        "rules": {
          "style": { "noDescendingSpecificity": "off" },
          "complexity": { "noImportantStyles": "off" }
        }
      }
    }
  ]
}
