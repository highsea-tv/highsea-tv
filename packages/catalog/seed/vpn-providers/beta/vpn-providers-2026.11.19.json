{"format":1,"kind":"vpn-providers","version":"2026.11.19","definitions":[{"id":"airvpn","version":"1.0.0","minEngineVersion":"1.0.0","name":"AirVPN","connect":"config","steps":["Sign in at airvpn.org and open Client Area › Config Generator.","Choose Linux and WireGuard, pick a country or server, and generate the file.","Upload it here. To forward a port, reserve one under Client Area › Forwarded ports and type it below."],"links":[{"label":"AirVPN’s Config Generator","url":"https://airvpn.org/generator/"},{"label":"Remote port forwarding","url":"https://airvpn.org/faq/port_forwarding/"}],"portForwarding":{"method":"static"},"ipv6":true,"sources":["https://airvpn.org/faq/port_forwarding/","https://github.com/qdm12/gluetun-wiki/blob/main/setup/providers/airvpn.md"]},{"id":"ivpn","version":"1.0.0","minEngineVersion":"1.0.0","name":"IVPN","connect":"config","steps":["Sign in at ivpn.net and open the Client Area’s WireGuard configuration generator. It needs an account id like i-XXXX-XXXX-XXXX.","Generate a key, pick a server, and download the file.","Upload it here."],"links":[{"label":"IVPN’s configuration files","url":"https://www.ivpn.net/knowledgebase/general/do-you-offer-openvpn-wireguard-config-files/"}],"portForwarding":{"method":"none"},"ipv6":false,"sources":["https://www.ivpn.net/knowledgebase/general/do-you-offer-openvpn-wireguard-config-files/","https://www.ivpn.net/blog/gradual-removal-of-port-forwarding"]},{"id":"mullvad","version":"1.0.0","minEngineVersion":"1.0.0","name":"Mullvad","connect":"config","steps":["Sign in at mullvad.net and open WireGuard configuration.","Generate a key for this server, pick a country and server, and download the file.","Upload it here."],"links":[{"label":"Mullvad’s WireGuard configuration","url":"https://mullvad.net/en/account/wireguard-config"}],"portForwarding":{"method":"none"},"ipv6":true,"check":{"url":"https://am.i.mullvad.net/json","field":"mullvad_exit_ip"},"sources":["https://mullvad.net/en/help/easy-wireguard-mullvad-setup-linux","https://mullvad.net/en/blog/removing-the-support-for-forwarded-ports"]},{"id":"nordvpn","version":"2.0.0","minEngineVersion":"1.1.0","name":"NordVPN","connect":"token","token":{"auth":{"scheme":"basic","username":"token"},"key":{"url":"https://api.nordvpn.com/v1/users/services/credentials","field":"nordlynx_private_key"},"servers":{"url":"https://api.nordvpn.com/v1/servers/recommendations?filters[servers_technologies][identifier]=wireguard_udp&filters[servers_technologies][pivot][status]=online&limit=1","host":"station","publicKey":"technologies[id=35].metadata[name=public_key].value","country":"filters[country_id]"},"countries":{"url":"https://api.nordvpn.com/v1/servers/countries","id":"id","name":"name","code":"code"},"tunnel":{"address":"10.5.0.2/32","port":51820,"dns":["103.86.96.100","103.86.99.100"]}},"steps":["Sign in to Nord Account, open NordVPN › Advanced settings › Get access token, enter the code Nord emails you, and generate a token. Copy it now; Nord shows it once.","Paste it here and pick a country, or leave the country to NordVPN. highsea fetches your NordLynx key and a recommended server with it, so there’s no file.","If you’d rather write the WireGuard file yourself, upload it instead; the token is used whenever it’s set."],"links":[{"label":"NordVPN’s access token","url":"https://support.nordvpn.com/hc/en-us/articles/45535038276753-How-to-generate-a-NordVPN-login-token-to-connect-to-a-VPN-server-on-a-router"},{"label":"NordVPN’s DNS servers","url":"https://support.nordvpn.com/hc/en-us/articles/19587726859793-What-are-NordVPN-DNS-server-addresses"}],"portForwarding":{"method":"none"},"ipv6":false,"regions":["Australia","Austria","Belgium","Canada","Czech Republic","Denmark","Finland","France","Germany","Ireland","Italy","Japan","Netherlands","Norway","Poland","Romania","Singapore","Spain","Sweden","Switzerland","United Kingdom","United States"],"sources":["https://support.nordvpn.com/hc/en-us/articles/45535038276753-How-to-generate-a-NordVPN-login-token-to-connect-to-a-VPN-server-on-a-router","https://support.nordvpn.com/hc/en-us/articles/19483392309649-Does-NordVPN-offer-port-forwarding","https://support.nordvpn.com/hc/en-us/articles/19587726859793-What-are-NordVPN-DNS-server-addresses","https://github.com/NordSecurity/libtelio/blob/main/README.md","https://github.com/NordSecurity/libtelio/blob/main/clis/tcli/src/nord.rs","https://github.com/NordSecurity/nordvpn-linux/blob/main/core/urls.go","https://github.com/NordSecurity/nordvpn-linux/blob/main/core/models.go","https://github.com/NordSecurity/nordvpn-linux/blob/main/daemon/vpn/nordlynx/nordlynx.go"]},{"id":"other","version":"1.0.0","minEngineVersion":"1.0.0","name":"Another WireGuard provider","connect":"config","steps":["Download a WireGuard configuration file from your provider. It needs a DNS line in its [Interface] section.","Upload it here. If they reserved a port for you, type it below."],"portForwarding":{"method":"static"},"ipv6":false,"sources":["https://git.zx2c4.com/wireguard-tools/about/src/man/wg-quick.8"]},{"id":"pia","version":"1.0.0","minEngineVersion":"1.0.0","name":"Private Internet Access","connect":"pia","steps":["Use the username and password you sign in to PIA with. The username starts with p.","Pick a region. highsea registers its own WireGuard key with PIA, so there’s no file."],"links":[{"label":"PIA’s manual connections","url":"https://github.com/pia-foss/manual-connections"}],"portForwarding":{"method":"pia"},"ipv6":false,"regions":["CA Montreal","CA Toronto","CA Vancouver","DE Frankfurt","DE Berlin","Netherlands","Sweden","Switzerland","Romania","Czech Republic"],"sources":["https://github.com/pia-foss/manual-connections"]},{"id":"proton","version":"1.0.0","minEngineVersion":"1.0.0","name":"Proton VPN","connect":"config","steps":["Sign in at account.protonvpn.com and open Downloads › WireGuard configuration.","Choose a server marked P2P (the double arrow), and turn on NAT-PMP (port forwarding).","Download the file and upload it here."],"links":[{"label":"Proton’s WireGuard configurations","url":"https://account.protonvpn.com/downloads"},{"label":"Port forwarding, by hand","url":"https://protonvpn.com/support/port-forwarding-manual-setup"}],"portForwarding":{"method":"natpmp","gateway":"10.2.0.1","lifetimeSeconds":60,"renewSeconds":45},"ipv6":true,"sources":["https://protonvpn.com/support/port-forwarding-manual-setup","https://protonvpn.com/support/wireguard-manual-linux"]},{"id":"surfshark","version":"1.0.0","minEngineVersion":"1.0.0","name":"Surfshark","connect":"config","steps":["Sign in at my.surfshark.com and open VPN › Manual setup › Desktop or mobile › WireGuard.","Generate a key pair (save it, Surfshark won’t show it again), choose a location, and download the file.","Upload it here."],"links":[{"label":"Surfshark’s manual WireGuard setup","url":"https://support.surfshark.com/hc/en-us/articles/19262406140306"}],"portForwarding":{"method":"none"},"ipv6":false,"sources":["https://support.surfshark.com/hc/en-us/articles/19262406140306","https://surfshark.com/blog/vpn-port-forwarding"]},{"id":"windscribe","version":"1.0.0","minEngineVersion":"1.0.0","name":"Windscribe","connect":"config","steps":["Sign in at windscribe.com and open My Account › Config Generator › WireGuard. It needs a paid account.","Choose a location and port 443, keep New Key Pair, and download the file.","Upload it here. To forward a port, open My Account › Port Forwarding, request an ephemeral port with Matching Port, and type it below. It lasts 7 days."],"links":[{"label":"Windscribe’s WireGuard configurations","url":"https://windscribe.com/knowledge-base/articles/where-do-i-access-my-wireguard-configs"},{"label":"Ephemeral port forwarding","url":"https://windscribe.com/knowledge-base/articles/what-is-ephemeral-port-forwarding-and-how-to-use-it"}],"portForwarding":{"method":"static"},"ipv6":false,"sources":["https://windscribe.com/knowledge-base/articles/where-do-i-access-my-wireguard-configs","https://windscribe.com/knowledge-base/articles/do-you-support-port-forwarding","https://windscribe.com/knowledge-base/articles/what-is-ephemeral-port-forwarding-and-how-to-use-it"]}],"logos":{}}