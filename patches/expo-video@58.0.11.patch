@@ -623,3 +628,30 @@ fileprivate extension AVPlayerItem.Status {
     }
   }
 }
+
+// highsea: an item's failure in words a report can carry: the error, each underlying error by its
+// domain and code (NSUnderlyingErrorKey), the error log's events and the access log's last three
+// (an event per URI the item read). Kept to about 1,800 characters, the report's limit being 2,000.
+func highseaDescribe(_ error: Error, item: AVPlayerItem) -> String {
+  var parts = [error.localizedDescription]
+  var under = (error as NSError).userInfo[NSUnderlyingErrorKey] as? NSError
+  var depth = 0
+  while let u = under, depth < 4 {
+    parts.append("under: \(u.domain) \(u.code)")
+    under = u.userInfo[NSUnderlyingErrorKey] as? NSError
+    depth += 1
+  }
+  let path = { (uri: String?) -> String in
+    guard let uri, let url = URL(string: uri) else { return uri ?? "" }
+    // the session's token is in the path: only the last two parts say which file
+    return url.pathComponents.suffix(2).joined(separator: "/")
+  }
+  for e in (item.errorLog()?.events ?? []).suffix(6) {
+    parts.append("errorLog: \(e.errorDomain) \(e.errorStatusCode) \(e.errorComment ?? "") \(path(e.uri))")
+  }
+  for e in (item.accessLog()?.events ?? []).suffix(3) {
+    parts.append("accessLog: \(path(e.uri)) requests \(e.numberOfMediaRequests) bytes \(e.numberOfBytesTransferred) stalls \(e.numberOfStalls)")
+  }
+  let line = parts.joined(separator: "; ")
+  return line.count > 1800 ? String(line.prefix(1800)) : line
+}
