+  #if os(tvOS)
+  // highsea: the player view controller is added as a child of the view controller that holds this
+  // view, as UIKit's view controller containment asks of a view controller whose view is embedded
+  // in another's: addChild(_:), the view in the hierarchy, then didMove(toParent:)
+  // (https://developer.apple.com/documentation/uikit/creating-a-custom-container-view-controller,
+  // https://developer.apple.com/documentation/uikit/uiviewcontroller/addchild(_:)). Without it the
+  // controller stands outside the focus environments' tree: its view takes focus on tvOS, and the
+  // app's own focus updates, requested from its root view, can't take focus back, since UIKit
+  // honours setNeedsFocusUpdate() only from an environment that contains the focused item
+  // (https://developer.apple.com/documentation/uikit/uifocusenvironment/setneedsfocusupdate()).
+  // Upstream issue to file; drop this patch once expo-video does the same.
+  private func attachPlayerViewController() {
+    guard self.window != nil, let parent = self.reactViewController() else {
+      return
+    }
+    let controller = playerViewController
+    if controller.parent === parent {
+      return
+    }
+    if controller.parent != nil {
+      controller.willMove(toParent: nil)
+      controller.removeFromParent()
+    }
+    parent.addChild(controller)
+    controller.didMove(toParent: parent)
+    // highsea: and with no controls of its own the view only shows the film, so it takes no user
+    // interaction and the focus engine passes it by, which a parent's alone doesn't make it do
+    // (https://developer.apple.com/documentation/uikit/about-focus-interactions-for-apple-tv)
+    controller.view.isUserInteractionEnabled = controller.showsPlaybackControls
+  }
+
+  private func detachPlayerViewController() {
+    let controller = playerViewController
+    guard controller.parent != nil else {
+      return
+    }
+    controller.willMove(toParent: nil)
+    controller.removeFromParent()
+  }
+  #endif
