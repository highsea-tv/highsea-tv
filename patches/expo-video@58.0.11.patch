-      error = PlayerItemLoadException(playerItemError?.localizedDescription)
+      // highsea: what AVPlayer knows of the failure goes in the message, which the app reports
+      // (HT-64): the underlying errors, then the item's error log and the last of its access log
+      // (https://developer.apple.com/documentation/avfoundation/avplayeritem/errorlog(),
